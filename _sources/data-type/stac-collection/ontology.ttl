<https://geolabs.github.io/bblocks-data-types/def/data-type/stac-collection/item> a dt:DataTypeItem, rim:RegisterItem ; dct:title "STAC Collection"@en ; rim:objectIdentifier "https://geolabs.github.io/bblocks-data-types/def/data-type/stac-collection/item"^^xsd:anyURI ; rim:itemClass dt:dataTypeItemClass ; rim:inRegister dt:register ; rim:realizes <https://geolabs.github.io/bblocks-data-types/def/data-type/stac-collection/v1> ; rim:validityStatus rim:invalid ; rim:publicationStatus rim:unpublished ; dct:isReplacedBy <https://w3id.org/geolabs-ospd/data-formats/format/stac-collection> ; rim:hasAction <https://geolabs.github.io/bblocks-data-types/def/data-type/stac-collection/actions/unpublication> .
<https://geolabs.github.io/bblocks-data-types/def/data-type/stac-collection/actions/unpublication> a rim:RegisterAction ; rim:actionType rim:unpublishAction ; rim:changeClassification rim:substantiveChange ; rim:proposer dt:geolabs ; rim:appliesTo <https://geolabs.github.io/bblocks-data-types/def/data-type/stac-collection/item> ; prov:startedAtTime "2026-11-11T00:00:00Z"^^xsd:dateTime ; dct:description "Withdrawal of the proposal (decision Q4, option b, of 2026-11-11): it describes an encoding, a STAC JSON object, not a kind of data, and no role of the Generic or Implementation Profiles uses it. It is replaced by the format https://w3id.org/geolabs-ospd/data-formats/format/stac-collection of the data-formats register, which carries rim:supersedes towards this item. Classified substantive: the retirement of a type."@en .
