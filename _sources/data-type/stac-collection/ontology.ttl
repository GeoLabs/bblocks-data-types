<https://w3id.org/geolabs/ospd/data-types/data-type/stac-collection> a dt:DataType, rim:Concept, skos:Concept ; skos:inScheme dt:dataTypes ; skos:prefLabel "STAC Collection"@en ; skos:definition "A STAC Collection: a Catalog specialization that describes a collection of related spatiotemporal assets with spatial and temporal extents."@en ; skos:broader <https://w3id.org/geolabs/ospd/data-types/data-type/stac-catalog> ; dct:source [ dct:title "STAC Collection JSON Schema"@en ; dct:references <https://github.com/radiantearth/stac-spec/blob/master/collection-spec/json-schema/collection.json> ], [ dct:title "STAC Catalog JSON Schema"@en ; dct:references <https://github.com/radiantearth/stac-spec/blob/master/catalog-spec/json-schema/catalog.json> ] .
<https://w3id.org/geolabs/ospd/data-types/data-type/stac-collection/v1> a dt:DataTypeVersion, rim:ConceptVersion ; rim:versionOf <https://w3id.org/geolabs/ospd/data-types/data-type/stac-collection> ; rim:version "1.0" ; rim:objectIdentifier "https://w3id.org/geolabs/ospd/data-types/data-type/stac-collection/v1"^^xsd:anyURI ; rim:functionalIdentifier "https://w3id.org/geolabs/ospd/data-types/data-type/stac-collection"^^xsd:anyURI ; rim:validityStatus rim:invalid ; rim:publicationStatus rim:unpublished ; dt:hasVersionAction <https://w3id.org/geolabs/ospd/data-types/data-type/stac-collection/actions/addition>, <https://w3id.org/geolabs/ospd/data-types/data-type/stac-collection/actions/unpublication> .
