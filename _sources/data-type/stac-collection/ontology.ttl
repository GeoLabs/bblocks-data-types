<https://w3id.org/geolabs/ospd/data-types/data-type/stac-collection/v1> owl:sameAs <https://geolabs.github.io/bblocks-data-types/def/data-type/stac-collection/v1> .
<https://w3id.org/geolabs/ospd/data-types/data-type/stac-collection/item> owl:sameAs <https://geolabs.github.io/bblocks-data-types/def/data-type/stac-collection/item> ;
