{
  "@context": {
    "@version": 1.1,
    "dt": "https://geolabs.github.io/bblocks-data-types/def/",
    "rim": "https://w3id.org/ogc/rim/",
    "skos": "http://www.w3.org/2004/02/skos/core#",
    "dct": "http://purl.org/dc/terms/",
    "prov": "http://www.w3.org/ns/prov#",
    "xsd": "http://www.w3.org/2001/XMLSchema#",
    "id": "@id",
    "type": "@type",

    "ConceptSystem": "rim:ConceptSystem",
    "DataType": "dt:DataType",
    "DataTypeVersion": "dt:DataTypeVersion",

    "prefLabel": "skos:prefLabel",
    "definition": "skos:definition",
    "inScheme": { "@id": "skos:inScheme", "@type": "@id" },
    "broader": { "@id": "skos:broader", "@type": "@id" },
    "concepts": { "@reverse": "skos:inScheme" },

    "versionOf": { "@id": "rim:versionOf", "@type": "@id" },
    "version": "rim:version",
    "objectIdentifier": { "@id": "rim:objectIdentifier", "@type": "xsd:anyURI" },
    "functionalIdentifier": { "@id": "rim:functionalIdentifier", "@type": "xsd:anyURI" },
    "validityStatus": { "@id": "rim:validityStatus", "@type": "@vocab" },
    "publicationStatus": { "@id": "rim:publicationStatus", "@type": "@vocab" },
    "valid": "rim:valid",
    "invalid": "rim:invalid",
    "published": "rim:published",
    "unpublished": "rim:unpublished",

    "hasAction": { "@id": "rim:hasAction", "@type": "@id" },
    "appliesTo": { "@id": "rim:appliesTo", "@type": "@id" },
    "proposer": { "@id": "rim:proposer", "@type": "@id" },
    "actionType": { "@id": "rim:actionType", "@type": "@vocab" },
    "addition": "rim:additionAction",
    "startedAtTime": { "@id": "prov:startedAtTime", "@type": "xsd:dateTime" },

    "source": "dct:source",
    "title": "dct:title",
    "link": { "@id": "dct:references", "@type": "@id" }
  }
}
