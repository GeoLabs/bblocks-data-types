@prefix dct: <http://purl.org/dc/terms/> .
@prefix dt: <https://geolabs.github.io/bblocks-data-types/def/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rim: <https://w3id.org/ogc/rim/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://geolabs.github.io/bblocks-data-types/def/data-type/feature/v1> a dt:DataTypeVersion,
        rim:ConceptVersion ;
    dt:hasVersionAction <https://geolabs.github.io/bblocks-data-types/def/data-type/feature/actions/addition> ;
    rim:functionalIdentifier "https://geolabs.github.io/bblocks-data-types/def/data-type/feature"^^xsd:anyURI ;
    rim:objectIdentifier "https://geolabs.github.io/bblocks-data-types/def/data-type/feature/v1"^^xsd:anyURI ;
    rim:publicationStatus rim:published ;
    rim:validityStatus rim:invalid ;
    rim:version "1.0" ;
    rim:versionOf <https://geolabs.github.io/bblocks-data-types/def/data-type/feature> .

<https://geolabs.github.io/bblocks-data-types/def/data-type/feature> a skos:Concept,
        dt:DataType,
        rim:Concept ;
    dct:source [ dct:title "ISO 19109:2015 Geographic information -- Rules for application schema"@en ],
        [ dct:references <https://docs.ogc.org/is/17-069r4/17-069r4.html> ;
            dct:title "OGC 17-069r4 OGC API - Features - Part 1: Core"@en ] ;
    skos:definition "A representation of a real-world phenomenon, with a geometry and properties, optionally identified by an identifier."@en ;
    skos:inScheme dt:dataTypes ;
    skos:prefLabel "Feature"@en .

<https://geolabs.github.io/bblocks-data-types/def/data-type/feature/actions/addition> a rim:RegisterAction ;
    prov:startedAtTime "2026-11-02T00:00:00+00:00"^^xsd:dateTime ;
    rim:actionType rim:additionAction ;
    rim:proposer dt:geolabs .

