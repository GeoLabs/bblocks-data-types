@prefix dct: <http://purl.org/dc/terms/> .
@prefix dt: <https://w3id.org/geolabs/ospd/data-types/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rim: <https://w3id.org/ogc/rim/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://w3id.org/geolabs/ospd/data-types/data-type/feature> a skos:Concept,
        dt:DataType,
        rim:Concept ;
    dct:source [ dct:title "ISO 19109:2015 Geographic information -- Rules for application schema"@en ],
        [ dct:references <https://docs.ogc.org/is/17-069r4/17-069r4.html> ;
            dct:title "OGC 17-069r4 OGC API - Features - Part 1: Core"@en ] ;
    owl:sameAs <https://geolabs.github.io/bblocks-data-types/def/data-type/feature> ;
    skos:definition "A representation of a real-world phenomenon, with a geometry and properties, optionally identified by an identifier."@en ;
    skos:inScheme dt:dataTypes ;
    skos:prefLabel "Feature"@en .

<https://w3id.org/geolabs/ospd/data-types/data-type/feature/actions/addition> a rim:RegisterAction ;
    prov:startedAtTime "2026-11-02T00:00:00+00:00"^^xsd:dateTime ;
    rim:actionType rim:additionAction ;
    rim:proposer <https://w3id.org/geolabs/ospd/org/geolabs> .

<https://w3id.org/geolabs/ospd/data-types/data-type/feature/actions/identifier-2026-11-17> a rim:RegisterAction ;
    dct:description "The object identifier of this item moves from https://geolabs.github.io/bblocks-data-types/def/data-type/feature/item to https://w3id.org/geolabs/ospd/data-types/data-type/feature/item, which resolves through w3id.org (decision of 2026-11-17); the register actions of the item move with it, under https://w3id.org/geolabs/ospd/data-types/data-type/feature/actions/. The old IRI is kept as owl:sameAs. The content of the item is unchanged. Classified clarifying: the item is the same, only its identifier changes. The data type and its version keep their old IRIs as owl:sameAs too."@en ;
    prov:startedAtTime "2026-11-17T00:00:00+00:00"^^xsd:dateTime ;
    rim:actionType dt:amendmentAction ;
    rim:affectedProperty rim:objectIdentifier ;
    rim:appliesTo <https://w3id.org/geolabs/ospd/data-types/data-type/feature/item> ;
    rim:changeClassification rim:clarifyingChange ;
    rim:proposer <https://w3id.org/geolabs/ospd/org/geolabs> .

<https://w3id.org/geolabs/ospd/data-types/data-type/feature/item> a dt:DataTypeItem,
        rim:RegisterItem ;
    dct:title "Feature"@en ;
    owl:sameAs <https://geolabs.github.io/bblocks-data-types/def/data-type/feature/item> ;
    rim:hasAction <https://w3id.org/geolabs/ospd/data-types/data-type/feature/actions/identifier-2026-11-17> ;
    rim:inRegister dt:register ;
    rim:itemClass dt:dataTypeItemClass ;
    rim:objectIdentifier "https://w3id.org/geolabs/ospd/data-types/data-type/feature/item"^^xsd:anyURI ;
    rim:publicationStatus rim:published ;
    rim:realizes <https://w3id.org/geolabs/ospd/data-types/data-type/feature/v1> ;
    rim:validityStatus rim:invalid .

<https://w3id.org/geolabs/ospd/data-types/data-type/feature/v1> a dt:DataTypeVersion,
        rim:ConceptVersion ;
    owl:sameAs <https://geolabs.github.io/bblocks-data-types/def/data-type/feature/v1> ;
    dt:hasVersionAction <https://w3id.org/geolabs/ospd/data-types/data-type/feature/actions/addition> ;
    rim:functionalIdentifier "https://w3id.org/geolabs/ospd/data-types/data-type/feature"^^xsd:anyURI ;
    rim:objectIdentifier "https://w3id.org/geolabs/ospd/data-types/data-type/feature/v1"^^xsd:anyURI ;
    rim:publicationStatus rim:published ;
    rim:validityStatus rim:invalid ;
    rim:version "1.0" ;
    rim:versionOf <https://w3id.org/geolabs/ospd/data-types/data-type/feature> .

