<https://w3id.org/geolabs/ospd/data-types/data-type/string-date-time> a skos:Concept,
        dt:DataType,
        rim:Concept ;
    dct:source [ dct:references <https://raw.githubusercontent.com/eoap/schemas/main/string_format.yaml> ;
            dct:title "EOAP schemas: string_format.yaml (JSON Schema format: date-time)"@en ] ;
    owl:sameAs <https://geolabs.github.io/bblocks-data-types/def/data-type/string-date-time> ;
    skos:broader <https://w3id.org/geolabs/ospd/data-types/data-type/string> ;
    skos:definition "A string representing a date and time in the YYYY-MM-DDThh:mm:ss.sTZD format."@en ;
    skos:inScheme dt:dataTypes ;
    skos:prefLabel "Date-time string"@en .

<https://w3id.org/geolabs/ospd/data-types/data-type/string-date-time/actions/addition> a rim:RegisterAction ;
    prov:startedAtTime "2026-11-01T00:00:00+00:00"^^xsd:dateTime ;
    rim:actionType rim:additionAction ;
    rim:proposer dt:geolabs .

<https://w3id.org/geolabs/ospd/data-types/data-type/string-date-time/actions/identifier-2026-11-17> a rim:RegisterAction ;
    dct:description "The object identifier of this item moves from https://geolabs.github.io/bblocks-data-types/def/data-type/string-date-time/item to https://w3id.org/geolabs/ospd/data-types/data-type/string-date-time/item, which resolves through w3id.org (decision of 2026-11-17); the register actions of the item move with it, under https://w3id.org/geolabs/ospd/data-types/data-type/string-date-time/actions/. The old IRI is kept as owl:sameAs. The content of the item is unchanged. Classified clarifying: the item is the same, only its identifier changes. The data type and its version keep their old IRIs as owl:sameAs too."@en ;
    prov:startedAtTime "2026-11-17T00:00:00+00:00"^^xsd:dateTime ;
    rim:actionType dt:amendmentAction ;
    rim:affectedProperty rim:objectIdentifier ;
    rim:appliesTo <https://w3id.org/geolabs/ospd/data-types/data-type/string-date-time/item> ;
    rim:changeClassification rim:clarifyingChange ;
    rim:proposer dt:geolabs .

<https://w3id.org/geolabs/ospd/data-types/data-type/string-date-time/v1> a dt:DataTypeVersion,
        rim:ConceptVersion ;
    owl:sameAs <https://geolabs.github.io/bblocks-data-types/def/data-type/string-date-time/v1> ;
    dt:hasVersionAction <https://w3id.org/geolabs/ospd/data-types/data-type/string-date-time/actions/addition>,
        <https://w3id.org/geolabs/ospd/data-types/data-type/string-date-time/actions/unpublication> ;
    rim:functionalIdentifier "https://w3id.org/geolabs/ospd/data-types/data-type/string-date-time"^^xsd:anyURI ;
    rim:objectIdentifier "https://w3id.org/geolabs/ospd/data-types/data-type/string-date-time/v1"^^xsd:anyURI ;
    rim:publicationStatus rim:unpublished ;
    rim:validityStatus rim:invalid ;
    rim:version "1.0" ;
    rim:versionOf <https://w3id.org/geolabs/ospd/data-types/data-type/string-date-time> .

<https://w3id.org/geolabs/ospd/data-types/data-type/string-date-time/actions/unpublication> a rim:RegisterAction ;
    dct:description "Withdrawal of the proposal: this is a format, not a kind of data. It is replaced by the format https://w3id.org/geolabs/ospd/data-formats/format/string-date-time of the data-formats register, which carries rim:supersedes towards this item. Classified substantive: the retirement of a type."@en ;
    prov:startedAtTime "2026-11-09T00:00:00+00:00"^^xsd:dateTime ;
    rim:actionType rim:unpublishAction ;
    rim:appliesTo <https://w3id.org/geolabs/ospd/data-types/data-type/string-date-time/item> ;
    rim:changeClassification rim:substantiveChange ;
    rim:proposer dt:geolabs .

<https://w3id.org/geolabs/ospd/data-types/data-type/string-date-time/item> a dt:DataTypeItem,
        rim:RegisterItem ;
    dct:isReplacedBy <https://w3id.org/geolabs/ospd/data-formats/format/string-date-time> ;
    dct:title "Date-time string"@en ;
    owl:sameAs <https://geolabs.github.io/bblocks-data-types/def/data-type/string-date-time/item> ;
    rim:hasAction <https://w3id.org/geolabs/ospd/data-types/data-type/string-date-time/actions/identifier-2026-11-17>,
        <https://w3id.org/geolabs/ospd/data-types/data-type/string-date-time/actions/unpublication> ;
    rim:inRegister dt:register ;
    rim:itemClass dt:dataTypeItemClass ;
    rim:objectIdentifier "https://w3id.org/geolabs/ospd/data-types/data-type/string-date-time/item"^^xsd:anyURI ;
