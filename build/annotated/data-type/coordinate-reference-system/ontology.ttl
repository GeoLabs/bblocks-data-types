@prefix dct: <http://purl.org/dc/terms/> .
@prefix dt: <https://geolabs.github.io/bblocks-data-types/def/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rim: <https://w3id.org/ogc/rim/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://geolabs.github.io/bblocks-data-types/def/data-type/coordinate-reference-system/item> a dt:DataTypeItem,
        rim:RegisterItem ;
    dct:title "Coordinate reference system"@en ;
    rim:inRegister dt:register ;
    rim:itemClass dt:dataTypeItemClass ;
    rim:objectIdentifier "https://geolabs.github.io/bblocks-data-types/def/data-type/coordinate-reference-system/item"^^xsd:anyURI ;
    rim:publicationStatus rim:published ;
    rim:realizes <https://geolabs.github.io/bblocks-data-types/def/data-type/coordinate-reference-system/v1> ;
    rim:validityStatus rim:invalid .

<https://geolabs.github.io/bblocks-data-types/def/data-type/coordinate-reference-system> a skos:Concept,
        dt:DataType,
        rim:Concept ;
    dct:source [ dct:references <https://docs.ogc.org/as/18-005r5/18-005r5.html> ;
            dct:title "OGC 18-005r5 Topic 2 - Referencing by coordinates (ISO 19111:2019), 3.1.9 coordinate reference system"@en ],
        [ dct:references <https://geolabs.github.io/bblocks-generic-profiles/def/generic-profile/raster-reprojection/inputs/targetCRS> ;
            dct:title "Generic Profile raster-reprojection (bblocks-generic-profiles), the role that requests this type"@en ] ;
    skos:definition "A coordinate system that is related to an object by a datum."@en ;
    skos:inScheme dt:dataTypes ;
    skos:prefLabel "Coordinate reference system"@en .

<https://geolabs.github.io/bblocks-data-types/def/data-type/coordinate-reference-system/actions/addition> a rim:RegisterAction ;
    prov:startedAtTime "2026-11-09T00:00:00+00:00"^^xsd:dateTime ;
    rim:actionType rim:additionAction ;
    rim:proposer dt:geolabs .

<https://geolabs.github.io/bblocks-data-types/def/data-type/coordinate-reference-system/v1> a dt:DataTypeVersion,
        rim:ConceptVersion ;
    dt:hasVersionAction <https://geolabs.github.io/bblocks-data-types/def/data-type/coordinate-reference-system/actions/addition> ;
    rim:functionalIdentifier "https://geolabs.github.io/bblocks-data-types/def/data-type/coordinate-reference-system"^^xsd:anyURI ;
    rim:objectIdentifier "https://geolabs.github.io/bblocks-data-types/def/data-type/coordinate-reference-system/v1"^^xsd:anyURI ;
    rim:publicationStatus rim:published ;
    rim:validityStatus rim:invalid ;
    rim:version "1.0" ;
    rim:versionOf <https://geolabs.github.io/bblocks-data-types/def/data-type/coordinate-reference-system> .

