@prefix dct: <http://purl.org/dc/terms/> .
@prefix dt: <https://w3id.org/geolabs/ospd/data-types/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rim: <https://w3id.org/ogc/rim/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://w3id.org/geolabs/ospd/data-types/data-type/polygon> a skos:Concept,
        dt:DataType,
        rim:Concept ;
    dct:source [ dct:references <https://www.ogc.org/standards/sfa/> ;
            dct:title "OGC 06-103r4 Simple Feature Access - Part 1: Common Architecture"@en ],
        [ dct:references <https://docs.ogc.org/is/23-034/23-034.html> ;
            dct:title "OGC 23-034 OGC CDB Version 2 - Part 1: Core Standard, 7.6 Geometry"@en ] ;
    owl:sameAs <https://geolabs.github.io/bblocks-data-types/def/data-type/polygon> ;
    skos:broader <https://w3id.org/geolabs/ospd/data-types/data-type/surface> ;
    skos:definition "A planar surface defined by one exterior boundary and zero or more interior boundaries; each interior boundary defines a hole in the polygon."@en ;
    skos:inScheme dt:dataTypes ;
    skos:prefLabel "Polygon"@en .

<https://w3id.org/geolabs/ospd/data-types/data-type/polygon/actions/addition> a rim:RegisterAction ;
    prov:startedAtTime "2026-11-01T00:00:00+00:00"^^xsd:dateTime ;
    rim:actionType rim:additionAction ;
    rim:proposer <https://w3id.org/geolabs/ospd/org/geolabs> .

<https://w3id.org/geolabs/ospd/data-types/data-type/polygon/actions/identifier-2026-11-17> a rim:RegisterAction ;
    dct:description "The object identifier of this item moves from https://geolabs.github.io/bblocks-data-types/def/data-type/polygon/item to https://w3id.org/geolabs/ospd/data-types/data-type/polygon/item, which resolves through w3id.org (decision of 2026-11-17); the register actions of the item move with it, under https://w3id.org/geolabs/ospd/data-types/data-type/polygon/actions/. The old IRI is kept as owl:sameAs. The content of the item is unchanged. Classified clarifying: the item is the same, only its identifier changes. The data type and its version keep their old IRIs as owl:sameAs too."@en ;
    prov:startedAtTime "2026-11-17T00:00:00+00:00"^^xsd:dateTime ;
    rim:actionType dt:amendmentAction ;
    rim:affectedProperty rim:objectIdentifier ;
    rim:appliesTo <https://w3id.org/geolabs/ospd/data-types/data-type/polygon/item> ;
    rim:changeClassification rim:clarifyingChange ;
    rim:proposer <https://w3id.org/geolabs/ospd/org/geolabs> .

<https://w3id.org/geolabs/ospd/data-types/data-type/polygon/item> a dt:DataTypeItem,
        rim:RegisterItem ;
    dct:title "Polygon"@en ;
    owl:sameAs <https://geolabs.github.io/bblocks-data-types/def/data-type/polygon/item> ;
    rim:hasAction <https://w3id.org/geolabs/ospd/data-types/data-type/polygon/actions/identifier-2026-11-17> ;
    rim:inRegister dt:register ;
    rim:itemClass dt:dataTypeItemClass ;
    rim:objectIdentifier "https://w3id.org/geolabs/ospd/data-types/data-type/polygon/item"^^xsd:anyURI ;
    rim:publicationStatus rim:published ;
    rim:realizes <https://w3id.org/geolabs/ospd/data-types/data-type/polygon/v1> ;
    rim:validityStatus rim:invalid .

<https://w3id.org/geolabs/ospd/data-types/data-type/polygon/v1> a dt:DataTypeVersion,
        rim:ConceptVersion ;
    owl:sameAs <https://geolabs.github.io/bblocks-data-types/def/data-type/polygon/v1> ;
    dt:hasVersionAction <https://w3id.org/geolabs/ospd/data-types/data-type/polygon/actions/addition> ;
    rim:functionalIdentifier "https://w3id.org/geolabs/ospd/data-types/data-type/polygon"^^xsd:anyURI ;
    rim:objectIdentifier "https://w3id.org/geolabs/ospd/data-types/data-type/polygon/v1"^^xsd:anyURI ;
    rim:publicationStatus rim:published ;
    rim:validityStatus rim:invalid ;
    rim:version "1.0" ;
    rim:versionOf <https://w3id.org/geolabs/ospd/data-types/data-type/polygon> .

