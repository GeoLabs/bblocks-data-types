<https://w3id.org/geolabs/ospd/data-types/data-type/binary-mask/actions/identifier-2026-11-17> a rim:RegisterAction ;
    dct:description "The object identifier of this item moves from https://geolabs.github.io/bblocks-data-types/def/data-type/binary-mask/item to https://w3id.org/geolabs/ospd/data-types/data-type/binary-mask/item, which resolves through w3id.org (decision of 2026-11-17); the register actions of the item move with it, under https://w3id.org/geolabs/ospd/data-types/data-type/binary-mask/actions/. The old IRI is kept as owl:sameAs. The content of the item is unchanged. Classified clarifying: the item is the same, only its identifier changes. The data type and its version keep their old IRIs as owl:sameAs too."@en ;
    prov:startedAtTime "2026-11-17T00:00:00+00:00"^^xsd:dateTime ;
    rim:actionType dt:amendmentAction ;
    rim:affectedProperty rim:objectIdentifier ;
    rim:appliesTo <https://w3id.org/geolabs/ospd/data-types/data-type/binary-mask/item> ;
    rim:changeClassification rim:clarifyingChange ;
    rim:proposer <https://w3id.org/geolabs/ospd/org/geolabs> .

