<https://w3id.org/geolabs/ospd/data-types/data-type/binary-mask> a skos:Concept,
        dt:DataType,
        rim:Concept ;
    dct:source [ dct:references <https://w3id.org/geolabs/ospd/generic-profiles/generic-profile/raster-thresholding/outputs/mask> ;
            dct:title "Generic Profile raster-thresholding (bblocks-generic-profiles), the role that requests this type"@en ] ;
