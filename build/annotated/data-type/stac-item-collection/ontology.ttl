@prefix dct: <http://purl.org/dc/terms/> .
@prefix dt: <https://geolabs.github.io/bblocks-data-types/def/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rim: <https://w3id.org/ogc/rim/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://geolabs.github.io/bblocks-data-types/def/data-type/stac-item-collection> a skos:Concept,
        dt:DataType,
        rim:Concept ;
    dct:source [ dct:references <https://raw.githubusercontent.com/eoap/schemas/main/stac.yaml> ;
            dct:title "EOAP schemas: stac.yaml (STAC Item)"@en ],
        [ dct:references <https://api.stacspec.org/v1.0.0/item-search/> ;
            dct:title "STAC API Item Search"@en ],
        [ dct:references <https://docs.ogc.org/is/17-069r4/17-069r4.html> ;
            dct:title "OGC 17-069r4 OGC API - Features - Part 1: Core"@en ] ;
    skos:broader <https://geolabs.github.io/bblocks-data-types/def/data-type/feature-collection> ;
    skos:definition "A feature collection whose features are STAC Items, such as a STAC API Item Search response; distinct from a STAC Collection object."@en ;
    skos:inScheme dt:dataTypes ;
    skos:prefLabel "STAC Item Collection"@en .

<https://geolabs.github.io/bblocks-data-types/def/data-type/stac-item-collection/actions/addition> a rim:RegisterAction ;
    prov:startedAtTime "2026-11-01T00:00:00+00:00"^^xsd:dateTime ;
    rim:actionType rim:additionAction ;
    rim:proposer dt:geolabs .

<https://geolabs.github.io/bblocks-data-types/def/data-type/stac-item-collection/item> a dt:DataTypeItem,
        rim:RegisterItem ;
    dct:isReplacedBy <https://w3id.org/geolabs/ospd/data-formats/format/stac-item-collection> ;
    dct:title "STAC Item Collection"@en ;
    rim:hasAction <https://geolabs.github.io/bblocks-data-types/def/data-type/stac-item-collection/actions/unpublication> ;
    rim:inRegister dt:register ;
    rim:itemClass dt:dataTypeItemClass ;
    rim:objectIdentifier "https://geolabs.github.io/bblocks-data-types/def/data-type/stac-item-collection/item"^^xsd:anyURI ;
    rim:publicationStatus rim:unpublished ;
    rim:realizes <https://geolabs.github.io/bblocks-data-types/def/data-type/stac-item-collection/v1> ;
    rim:validityStatus rim:invalid .

<https://geolabs.github.io/bblocks-data-types/def/data-type/stac-item-collection/v1> a dt:DataTypeVersion,
        rim:ConceptVersion ;
    dt:hasVersionAction <https://geolabs.github.io/bblocks-data-types/def/data-type/stac-item-collection/actions/addition>,
        <https://geolabs.github.io/bblocks-data-types/def/data-type/stac-item-collection/actions/unpublication> ;
    rim:functionalIdentifier "https://geolabs.github.io/bblocks-data-types/def/data-type/stac-item-collection"^^xsd:anyURI ;
    rim:objectIdentifier "https://geolabs.github.io/bblocks-data-types/def/data-type/stac-item-collection/v1"^^xsd:anyURI ;
    rim:publicationStatus rim:unpublished ;
    rim:validityStatus rim:invalid ;
    rim:version "1.0" ;
    rim:versionOf <https://geolabs.github.io/bblocks-data-types/def/data-type/stac-item-collection> .

<https://geolabs.github.io/bblocks-data-types/def/data-type/stac-item-collection/actions/unpublication> a rim:RegisterAction ;
    dct:description "Withdrawal of the proposal (decision Q4, option b, of 2026-11-11): it describes an encoding, a STAC JSON object, not a kind of data, and no role of the Generic or Implementation Profiles uses it. It is replaced by the format https://w3id.org/geolabs/ospd/data-formats/format/stac-item-collection of the data-formats register, which carries rim:supersedes towards this item. Classified substantive: the retirement of a type."@en ;
    prov:startedAtTime "2026-11-11T00:00:00+00:00"^^xsd:dateTime ;
    rim:actionType rim:unpublishAction ;
    rim:appliesTo <https://geolabs.github.io/bblocks-data-types/def/data-type/stac-item-collection/item> ;
    rim:changeClassification rim:substantiveChange ;
    rim:proposer dt:geolabs .

