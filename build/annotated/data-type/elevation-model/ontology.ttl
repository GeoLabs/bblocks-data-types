@prefix dct: <http://purl.org/dc/terms/> .
@prefix dt: <https://geolabs.github.io/bblocks-data-types/def/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rim: <https://w3id.org/ogc/rim/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://geolabs.github.io/bblocks-data-types/def/data-type/elevation-model> a skos:Concept,
        dt:DataType,
        rim:Concept ;
    dct:source [ dct:references <https://docs.ogc.org/is/09-146r8/09-146r8.html> ;
            dct:title "OGC 09-146r8 Coverage Implementation Schema (CIS) 1.1.1, §6.5 RangeType"@en ],
        [ dct:references <https://inspire.ec.europa.eu/id/document/tg/el> ;
            dct:title "INSPIRE D2.8.II.1 Data Specification on Elevation – Technical Guidelines, D2.8.II.1_v3.3.0 (2024-01-31): Executive Summary, and §2.4 Terms and definitions, (6) Digital Elevation Model, (7) Digital Surface Model, (8) Digital Terrain Model"@en ] ;
    skos:broader <https://geolabs.github.io/bblocks-data-types/def/data-type/raster-single-band> ;
    skos:definition "A single-band raster whose values are elevations of the terrain or of a surface (DEM, DTM, DSM)."@en ;
    skos:inScheme dt:dataTypes ;
    skos:prefLabel "Elevation model"@en ;
    skos:scopeNote "INSPIRE also admits vector and TIN representations of an elevation model; this type covers the grid one."@en .

<https://geolabs.github.io/bblocks-data-types/def/data-type/elevation-model/actions/addition> a rim:RegisterAction ;
    prov:startedAtTime "2026-10-08T00:00:00+00:00"^^xsd:dateTime ;
    rim:actionType rim:additionAction ;
    rim:proposer dt:geolabs .

<https://geolabs.github.io/bblocks-data-types/def/data-type/elevation-model/v1> a dt:DataTypeVersion,
        rim:ConceptVersion ;
    dt:hasVersionAction <https://geolabs.github.io/bblocks-data-types/def/data-type/elevation-model/actions/addition>,
        <https://geolabs.github.io/bblocks-data-types/def/data-type/elevation-model/actions/amendment-inspire-version>,
        <https://geolabs.github.io/bblocks-data-types/def/data-type/elevation-model/actions/amendment-source> ;
    rim:functionalIdentifier "https://geolabs.github.io/bblocks-data-types/def/data-type/elevation-model"^^xsd:anyURI ;
    rim:objectIdentifier "https://geolabs.github.io/bblocks-data-types/def/data-type/elevation-model/v1"^^xsd:anyURI ;
    rim:publicationStatus rim:published ;
    rim:validityStatus rim:invalid ;
    rim:version "1.0" ;
    rim:versionOf <https://geolabs.github.io/bblocks-data-types/def/data-type/elevation-model> .

<https://geolabs.github.io/bblocks-data-types/def/data-type/elevation-model/actions/amendment-inspire-version> a rim:RegisterAction ;
    dct:description "In-place amendment of a proposal: the INSPIRE source now gives its version, D2.8.II.1_v3.3.0, and cites the term definitions of its section 2.4, (6) to (8), besides the executive summary; a scope note says that INSPIRE also admits vector and TIN representations and that this type covers the grid one. The definition and skos:broader are unchanged. Classified clarifying: the type covers the same data."@en ;
    prov:startedAtTime "2026-11-09T00:00:00+00:00"^^xsd:dateTime ;
    rim:actionType dt:amendmentAction ;
    rim:affectedProperty dct:source,
        skos:scopeNote ;
    rim:appliesTo <https://geolabs.github.io/bblocks-data-types/def/data-type/elevation-model/item> ;
    rim:changeClassification rim:clarifyingChange ;
    rim:proposer dt:geolabs .

<https://geolabs.github.io/bblocks-data-types/def/data-type/elevation-model/actions/amendment-source> a rim:RegisterAction ;
    dct:description "In-place amendment of a proposal: the source SAGA 7.3.0 Terrain Analysis tools, a tool, is replaced by the INSPIRE Data Specification on Elevation, which defines digital elevation, terrain and surface models. The definition is unchanged. Classified clarifying: a source changes and the type covers the same data."@en ;
    prov:startedAtTime "2026-11-09T00:00:00+00:00"^^xsd:dateTime ;
    rim:actionType dt:amendmentAction ;
    rim:affectedProperty dct:source ;
    rim:appliesTo <https://geolabs.github.io/bblocks-data-types/def/data-type/elevation-model/item> ;
    rim:changeClassification rim:clarifyingChange ;
    rim:proposer dt:geolabs .

<https://geolabs.github.io/bblocks-data-types/def/data-type/elevation-model/item> a dt:DataTypeItem,
        rim:RegisterItem ;
    dct:title "Elevation model"@en ;
    rim:hasAction <https://geolabs.github.io/bblocks-data-types/def/data-type/elevation-model/actions/amendment-inspire-version>,
        <https://geolabs.github.io/bblocks-data-types/def/data-type/elevation-model/actions/amendment-source> ;
    rim:inRegister dt:register ;
    rim:itemClass dt:dataTypeItemClass ;
    rim:objectIdentifier "https://geolabs.github.io/bblocks-data-types/def/data-type/elevation-model/item"^^xsd:anyURI ;
    rim:publicationStatus rim:published ;
    rim:realizes <https://geolabs.github.io/bblocks-data-types/def/data-type/elevation-model/v1> ;
    rim:validityStatus rim:invalid .

