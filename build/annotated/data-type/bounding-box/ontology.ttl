<https://geolabs.github.io/bblocks-data-types/def/data-type/bounding-box> a skos:Concept,
        dt:DataType,
        rim:Concept ;
    dct:source [ dct:references <https://docs.ogc.org/is/17-069r4/17-069r4.html> ;
            dct:title "ogc.api.processes.v1.schemas.bbox, after OGC 17-069r4 §7.15.3 bbox"@en ] ;
    skos:definition "An axis-aligned extent given by its corners, with its CRS."@en ;
