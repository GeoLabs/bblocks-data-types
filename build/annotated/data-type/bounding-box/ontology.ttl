@prefix dct: <http://purl.org/dc/terms/> .
@prefix dt: <https://geolabs.github.io/bblocks-data-types/def/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rim: <https://w3id.org/ogc/rim/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://geolabs.github.io/bblocks-data-types/def/data-type/bounding-box> a skos:Concept,
        dt:DataType,
        rim:Concept ;
    dct:source [ dct:references <https://docs.ogc.org/is/17-069r4/17-069r4.html> ;
            dct:title "ogc.api.processes.part1.v1.schemas.bbox, after OGC 17-069r4 §7.15.3 bbox"@en ] ;
    skos:definition "An axis-aligned extent given by its corners, with its CRS."@en ;
    skos:inScheme dt:dataTypes ;
    skos:prefLabel "Bounding box"@en .

<https://geolabs.github.io/bblocks-data-types/def/data-type/bounding-box/actions/addition> a rim:RegisterAction ;
    prov:startedAtTime "2026-10-08T00:00:00+00:00"^^xsd:dateTime ;
    rim:actionType rim:additionAction ;
    rim:proposer dt:geolabs .

<https://geolabs.github.io/bblocks-data-types/def/data-type/bounding-box/actions/amendment-source-title> a rim:RegisterAction ;
    dct:description "In-place amendment of a proposal: the title of the source that names the OGC API - Processes bbox building block follows its renaming by GeoLabs on 2026-11-10, from ogc.api.processes.v1.schemas.bbox to ogc.api.processes.part1.v1.schemas.bbox (Part 1, edition 1.0). The source, the definition and skos:broader are unchanged. Classified clarifying: the type covers the same data."@en ;
    prov:startedAtTime "2026-11-10T00:00:00+00:00"^^xsd:dateTime ;
    rim:actionType dt:amendmentAction ;
    rim:affectedProperty dct:source ;
    rim:appliesTo <https://geolabs.github.io/bblocks-data-types/def/data-type/bounding-box/item> ;
    rim:changeClassification rim:clarifyingChange ;
    rim:proposer dt:geolabs .

<https://geolabs.github.io/bblocks-data-types/def/data-type/bounding-box/item> a dt:DataTypeItem,
        rim:RegisterItem ;
    dct:title "Bounding box"@en ;
    rim:hasAction <https://geolabs.github.io/bblocks-data-types/def/data-type/bounding-box/actions/amendment-source-title> ;
    rim:inRegister dt:register ;
    rim:itemClass dt:dataTypeItemClass ;
    rim:objectIdentifier "https://geolabs.github.io/bblocks-data-types/def/data-type/bounding-box/item"^^xsd:anyURI ;
    rim:publicationStatus rim:published ;
    rim:realizes <https://geolabs.github.io/bblocks-data-types/def/data-type/bounding-box/v1> ;
    rim:validityStatus rim:invalid .

<https://geolabs.github.io/bblocks-data-types/def/data-type/bounding-box/v1> a dt:DataTypeVersion,
        rim:ConceptVersion ;
    dt:hasVersionAction <https://geolabs.github.io/bblocks-data-types/def/data-type/bounding-box/actions/addition> ;
    rim:functionalIdentifier "https://geolabs.github.io/bblocks-data-types/def/data-type/bounding-box"^^xsd:anyURI ;
    rim:objectIdentifier "https://geolabs.github.io/bblocks-data-types/def/data-type/bounding-box/v1"^^xsd:anyURI ;
    rim:publicationStatus rim:published ;
    rim:validityStatus rim:invalid ;
    rim:version "1.0" ;
    rim:versionOf <https://geolabs.github.io/bblocks-data-types/def/data-type/bounding-box> .

