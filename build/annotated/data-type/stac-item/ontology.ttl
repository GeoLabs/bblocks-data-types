@prefix dct: <http://purl.org/dc/terms/> .
@prefix dt: <https://geolabs.github.io/bblocks-data-types/def/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rim: <https://w3id.org/ogc/rim/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://geolabs.github.io/bblocks-data-types/def/data-type/stac-item> a skos:Concept,
        dt:DataType,
        rim:Concept ;
    dct:source [ dct:references <https://github.com/radiantearth/stac-spec/blob/master/item-spec/json-schema/item.json> ;
            dct:title "STAC Item JSON Schema"@en ] ;
    skos:broader <https://geolabs.github.io/bblocks-data-types/def/data-type/feature> ;
    skos:definition "A STAC Item: a feature with STAC identity, links, assets, version and spatiotemporal metadata."@en ;
    skos:inScheme dt:dataTypes ;
    skos:prefLabel "STAC Item"@en .

<https://geolabs.github.io/bblocks-data-types/def/data-type/stac-item/actions/addition> a rim:RegisterAction ;
    prov:startedAtTime "2026-11-02T00:00:00+00:00"^^xsd:dateTime ;
    rim:actionType rim:additionAction ;
    rim:proposer dt:geolabs .

<https://geolabs.github.io/bblocks-data-types/def/data-type/stac-item/item> a dt:DataTypeItem,
        rim:RegisterItem ;
    dct:isReplacedBy <https://w3id.org/geolabs/ospd/data-formats/format/stac-item> ;
    dct:title "STAC Item"@en ;
    rim:hasAction <https://geolabs.github.io/bblocks-data-types/def/data-type/stac-item/actions/unpublication> ;
    rim:inRegister dt:register ;
    rim:itemClass dt:dataTypeItemClass ;
    rim:objectIdentifier "https://geolabs.github.io/bblocks-data-types/def/data-type/stac-item/item"^^xsd:anyURI ;
    rim:publicationStatus rim:unpublished ;
    rim:realizes <https://geolabs.github.io/bblocks-data-types/def/data-type/stac-item/v1> ;
    rim:validityStatus rim:invalid .

<https://geolabs.github.io/bblocks-data-types/def/data-type/stac-item/v1> a dt:DataTypeVersion,
        rim:ConceptVersion ;
    dt:hasVersionAction <https://geolabs.github.io/bblocks-data-types/def/data-type/stac-item/actions/addition>,
        <https://geolabs.github.io/bblocks-data-types/def/data-type/stac-item/actions/unpublication> ;
    rim:functionalIdentifier "https://geolabs.github.io/bblocks-data-types/def/data-type/stac-item"^^xsd:anyURI ;
    rim:objectIdentifier "https://geolabs.github.io/bblocks-data-types/def/data-type/stac-item/v1"^^xsd:anyURI ;
    rim:publicationStatus rim:unpublished ;
    rim:validityStatus rim:invalid ;
    rim:version "1.0" ;
    rim:versionOf <https://geolabs.github.io/bblocks-data-types/def/data-type/stac-item> .

<https://geolabs.github.io/bblocks-data-types/def/data-type/stac-item/actions/unpublication> a rim:RegisterAction ;
    dct:description "Withdrawal of the proposal (decision Q4, option b, of 2026-11-11): it describes an encoding, a STAC JSON object, not a kind of data, and no role of the Generic or Implementation Profiles uses it. It is replaced by the format https://w3id.org/geolabs/ospd/data-formats/format/stac-item of the data-formats register, which carries rim:supersedes towards this item. Classified substantive: the retirement of a type."@en ;
    prov:startedAtTime "2026-11-11T00:00:00+00:00"^^xsd:dateTime ;
    rim:actionType rim:unpublishAction ;
    rim:appliesTo <https://geolabs.github.io/bblocks-data-types/def/data-type/stac-item/item> ;
    rim:changeClassification rim:substantiveChange ;
    rim:proposer dt:geolabs .

