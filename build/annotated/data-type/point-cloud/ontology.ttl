@prefix dct: <http://purl.org/dc/terms/> .
@prefix dt: <https://w3id.org/geolabs/ospd/data-types/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rim: <https://w3id.org/ogc/rim/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://w3id.org/geolabs/ospd/data-types/data-type/point-cloud> a skos:Concept,
        dt:DataType,
        rim:Concept ;
    dct:source [ dct:references <https://www.ogc.org/standards/las/> ;
            dct:title "OGC 17-030r1 LAS Specification 1.4 OGC Community Standard"@en ] ;
    owl:sameAs <https://geolabs.github.io/bblocks-data-types/def/data-type/point-cloud> ;
    skos:definition "A set of three-dimensional points, each with its own attributes (intensity, classification, ...), typically from LiDAR."@en ;
    skos:inScheme dt:dataTypes ;
    skos:prefLabel "Point cloud"@en .

<https://w3id.org/geolabs/ospd/data-types/data-type/point-cloud/actions/addition> a rim:RegisterAction ;
    prov:startedAtTime "2026-10-08T00:00:00+00:00"^^xsd:dateTime ;
    rim:actionType rim:additionAction ;
    rim:proposer dt:geolabs .

<https://w3id.org/geolabs/ospd/data-types/data-type/point-cloud/actions/identifier-2026-11-17> a rim:RegisterAction ;
    dct:description "The object identifier of this item moves from https://geolabs.github.io/bblocks-data-types/def/data-type/point-cloud/item to https://w3id.org/geolabs/ospd/data-types/data-type/point-cloud/item, which resolves through w3id.org (decision of 2026-11-17); the register actions of the item move with it, under https://w3id.org/geolabs/ospd/data-types/data-type/point-cloud/actions/. The old IRI is kept as owl:sameAs. The content of the item is unchanged. Classified clarifying: the item is the same, only its identifier changes. The data type and its version keep their old IRIs as owl:sameAs too."@en ;
    prov:startedAtTime "2026-11-17T00:00:00+00:00"^^xsd:dateTime ;
    rim:actionType dt:amendmentAction ;
    rim:affectedProperty rim:objectIdentifier ;
    rim:appliesTo <https://w3id.org/geolabs/ospd/data-types/data-type/point-cloud/item> ;
    rim:changeClassification rim:clarifyingChange ;
    rim:proposer dt:geolabs .

<https://w3id.org/geolabs/ospd/data-types/data-type/point-cloud/item> a dt:DataTypeItem,
        rim:RegisterItem ;
    dct:title "Point cloud"@en ;
    owl:sameAs <https://geolabs.github.io/bblocks-data-types/def/data-type/point-cloud/item> ;
    rim:hasAction <https://w3id.org/geolabs/ospd/data-types/data-type/point-cloud/actions/identifier-2026-11-17> ;
    rim:inRegister dt:register ;
    rim:itemClass dt:dataTypeItemClass ;
    rim:objectIdentifier "https://w3id.org/geolabs/ospd/data-types/data-type/point-cloud/item"^^xsd:anyURI ;
    rim:publicationStatus rim:published ;
    rim:realizes <https://w3id.org/geolabs/ospd/data-types/data-type/point-cloud/v1> ;
    rim:validityStatus rim:invalid .

<https://w3id.org/geolabs/ospd/data-types/data-type/point-cloud/v1> a dt:DataTypeVersion,
        rim:ConceptVersion ;
    owl:sameAs <https://geolabs.github.io/bblocks-data-types/def/data-type/point-cloud/v1> ;
    dt:hasVersionAction <https://w3id.org/geolabs/ospd/data-types/data-type/point-cloud/actions/addition> ;
    rim:functionalIdentifier "https://w3id.org/geolabs/ospd/data-types/data-type/point-cloud"^^xsd:anyURI ;
    rim:objectIdentifier "https://w3id.org/geolabs/ospd/data-types/data-type/point-cloud/v1"^^xsd:anyURI ;
    rim:publicationStatus rim:published ;
    rim:validityStatus rim:invalid ;
    rim:version "1.0" ;
    rim:versionOf <https://w3id.org/geolabs/ospd/data-types/data-type/point-cloud> .

