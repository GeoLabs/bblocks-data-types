<https://w3id.org/geolabs/ospd/data-types/data-type/raster-single-band> a skos:Concept,
        dt:DataType,
        rim:Concept ;
    dct:source [ dct:references <https://docs.ogc.org/is/09-146r8/09-146r8.html> ;
            dct:title "OGC 09-146r8 Coverage Implementation Schema (CIS) 1.1.1, §6.5 RangeType"@en ] ;
    owl:sameAs <https://geolabs.github.io/bblocks-data-types/def/data-type/raster-single-band> ;
    skos:broader <https://w3id.org/geolabs/ospd/data-types/data-type/raster> ;
    skos:definition "A raster with exactly one band: a range type of one field."@en ;
    skos:inScheme dt:dataTypes ;
    skos:prefLabel "Raster (single band)"@en .

<https://w3id.org/geolabs/ospd/data-types/data-type/raster-single-band/actions/addition> a rim:RegisterAction ;
    prov:startedAtTime "2026-10-08T00:00:00+00:00"^^xsd:dateTime ;
    rim:actionType rim:additionAction ;
    rim:proposer dt:geolabs .

<https://w3id.org/geolabs/ospd/data-types/data-type/raster-single-band/actions/amendment-relations> a rim:RegisterAction ;
    dct:description "In-place amendment of a proposal: the Relations text of the block now lists Binary mask among the narrower data types, besides Elevation model, since binary-mask (added 2026-11-10) has this type as skos:broader. The definition and skos:broader of this type are unchanged. Classified clarifying: a documentary text; the type covers the same data."@en ;
    prov:startedAtTime "2026-11-10T00:00:00+00:00"^^xsd:dateTime ;
    rim:actionType dt:amendmentAction ;
    rim:appliesTo <https://w3id.org/geolabs/ospd/data-types/data-type/raster-single-band/item> ;
    rim:changeClassification rim:clarifyingChange ;
    rim:proposer dt:geolabs .

<https://w3id.org/geolabs/ospd/data-types/data-type/raster-single-band/actions/identifier-2026-11-17> a rim:RegisterAction ;
    dct:description "The object identifier of this item moves from https://geolabs.github.io/bblocks-data-types/def/data-type/raster-single-band/item to https://w3id.org/geolabs/ospd/data-types/data-type/raster-single-band/item, which resolves through w3id.org (decision of 2026-11-17); the register actions of the item move with it, under https://w3id.org/geolabs/ospd/data-types/data-type/raster-single-band/actions/. The old IRI is kept as owl:sameAs. The content of the item is unchanged. Classified clarifying: the item is the same, only its identifier changes. The data type and its version keep their old IRIs as owl:sameAs too."@en ;
    prov:startedAtTime "2026-11-17T00:00:00+00:00"^^xsd:dateTime ;
    rim:actionType dt:amendmentAction ;
    rim:affectedProperty rim:objectIdentifier ;
    rim:appliesTo <https://w3id.org/geolabs/ospd/data-types/data-type/raster-single-band/item> ;
    rim:changeClassification rim:clarifyingChange ;
    rim:proposer dt:geolabs .

<https://w3id.org/geolabs/ospd/data-types/data-type/raster-single-band/v1> a dt:DataTypeVersion,
        rim:ConceptVersion ;
    owl:sameAs <https://geolabs.github.io/bblocks-data-types/def/data-type/raster-single-band/v1> ;
    dt:hasVersionAction <https://w3id.org/geolabs/ospd/data-types/data-type/raster-single-band/actions/addition> ;
    rim:functionalIdentifier "https://w3id.org/geolabs/ospd/data-types/data-type/raster-single-band"^^xsd:anyURI ;
    rim:objectIdentifier "https://w3id.org/geolabs/ospd/data-types/data-type/raster-single-band/v1"^^xsd:anyURI ;
    rim:publicationStatus rim:published ;
    rim:validityStatus rim:invalid ;
    rim:version "1.0" ;
    rim:versionOf <https://w3id.org/geolabs/ospd/data-types/data-type/raster-single-band> .

<https://w3id.org/geolabs/ospd/data-types/data-type/raster-single-band/item> a dt:DataTypeItem,
        rim:RegisterItem ;
    dct:title "Raster (single band)"@en ;
