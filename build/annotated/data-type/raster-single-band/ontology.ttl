<https://geolabs.github.io/bblocks-data-types/def/data-type/raster-single-band> a skos:Concept,
        dt:DataType,
        rim:Concept ;
    dct:source [ dct:references <https://docs.ogc.org/is/09-146r8/09-146r8.html> ;
            dct:title "OGC 09-146r8 Coverage Implementation Schema (CIS) 1.1.1, §6.5 RangeType"@en ] ;
    skos:broader <https://geolabs.github.io/bblocks-data-types/def/data-type/raster> ;
    skos:definition "A raster with exactly one band: a range type of one field."@en ;
