@prefix dct: <http://purl.org/dc/terms/> .
@prefix dt: <https://geolabs.github.io/bblocks-data-types/def/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rim: <https://w3id.org/ogc/rim/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://geolabs.github.io/bblocks-data-types/def/data-type/stac-item/v1> a dt:DataTypeVersion,
        rim:ConceptVersion ;
    dt:hasVersionAction <https://geolabs.github.io/bblocks-data-types/def/data-type/stac-item/actions/addition> ;
    rim:functionalIdentifier "https://geolabs.github.io/bblocks-data-types/def/data-type/stac-item"^^xsd:anyURI ;
    rim:objectIdentifier "https://geolabs.github.io/bblocks-data-types/def/data-type/stac-item/v1"^^xsd:anyURI ;
    rim:publicationStatus rim:published ;
    rim:validityStatus rim:invalid ;
    rim:version "1.0" ;
    rim:versionOf <https://geolabs.github.io/bblocks-data-types/def/data-type/stac-item> .

<https://geolabs.github.io/bblocks-data-types/def/data-type/stac-item> a skos:Concept,
        dt:DataType,
        rim:Concept ;
    dct:source [ dct:references <https://github.com/radiantearth/stac-spec/blob/master/item-spec/json-schema/item.json> ;
            dct:title "STAC Item JSON Schema"@en ] ;
    skos:broader <https://geolabs.github.io/bblocks-data-types/def/data-type/feature> ;
    skos:definition "A STAC Item: a feature with STAC identity, links, assets, version and spatiotemporal metadata."@en ;
    skos:inScheme dt:dataTypes ;
    skos:prefLabel "STAC Item"@en .

<https://geolabs.github.io/bblocks-data-types/def/data-type/stac-item/actions/addition> a rim:RegisterAction ;
    prov:startedAtTime "2026-11-02T00:00:00+00:00"^^xsd:dateTime ;
    rim:actionType rim:additionAction ;
    rim:proposer dt:geolabs .

