@prefix dct: <http://purl.org/dc/terms/> .
@prefix dt: <https://geolabs.github.io/bblocks-data-types/def/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rim: <https://w3id.org/ogc/rim/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://geolabs.github.io/bblocks-data-types/def/data-type/string-duration/v1> a dt:DataTypeVersion,
        rim:ConceptVersion ;
    dt:hasVersionAction <https://geolabs.github.io/bblocks-data-types/def/data-type/string-duration/actions/addition> ;
    rim:functionalIdentifier "https://geolabs.github.io/bblocks-data-types/def/data-type/string-duration"^^xsd:anyURI ;
    rim:objectIdentifier "https://geolabs.github.io/bblocks-data-types/def/data-type/string-duration/v1"^^xsd:anyURI ;
    rim:publicationStatus rim:published ;
    rim:validityStatus rim:invalid ;
    rim:version "1.0" ;
    rim:versionOf <https://geolabs.github.io/bblocks-data-types/def/data-type/string-duration> .

<https://geolabs.github.io/bblocks-data-types/def/data-type/string-duration> a skos:Concept,
        dt:DataType,
        rim:Concept ;
    dct:source [ dct:references <https://raw.githubusercontent.com/eoap/schemas/main/string_format.yaml> ;
            dct:title "EOAP schemas: string_format.yaml (JSON Schema format: duration)"@en ] ;
    skos:broader <https://geolabs.github.io/bblocks-data-types/def/data-type/string> ;
    skos:definition "A string representing a duration as specified by ISO 8601."@en ;
    skos:inScheme dt:dataTypes ;
    skos:prefLabel "Duration string"@en .

<https://geolabs.github.io/bblocks-data-types/def/data-type/string-duration/actions/addition> a rim:RegisterAction ;
    prov:startedAtTime "2026-11-01T00:00:00+00:00"^^xsd:dateTime ;
    rim:actionType rim:additionAction ;
    rim:proposer dt:geolabs .

