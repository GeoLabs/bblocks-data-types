<https://geolabs.github.io/bblocks-data-types/def/data-type/multi-line-string/item> a dt:DataTypeItem ;
    rim:inRegister dt:register ;
    rim:itemClass dt:dataTypeItemClass ;
    rim:objectIdentifier "https://geolabs.github.io/bblocks-data-types/def/data-type/multi-line-string/item"^^xsd:anyURI ;
    rim:publicationStatus rim:published ;
    rim:realizes <https://geolabs.github.io/bblocks-data-types/def/data-type/multi-line-string/v1> ;
    rim:validityStatus rim:invalid .

<https://geolabs.github.io/bblocks-data-types/def/data-type/multi-line-string> a rim:Concept ;
    skos:definition "A multi-curve whose elements are line strings." ;
    skos:inScheme dt:data-types ;
    skos:prefLabel "MultiLineString" .

<https://geolabs.github.io/bblocks-data-types/def/data-type/multi-line-string/actions/addition> a rim:RegisterAction ;
    prov:startedAtTime "2026-11-01T00:00:00+00:00"^^xsd:dateTime ;
    rim:actionType rim:additionAction ;
    rim:proposer dt:geolabs .

<https://geolabs.github.io/bblocks-data-types/def/data-type/multi-line-string/v1> a dt:DataTypeVersion ;
    dt:hasVersionAction <https://geolabs.github.io/bblocks-data-types/def/data-type/multi-line-string/actions/addition> ;
