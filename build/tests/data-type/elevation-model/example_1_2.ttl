@prefix dct: <http://purl.org/dc/terms/> .
@prefix dt: <https://geolabs.github.io/bblocks-data-types/def/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rim: <https://w3id.org/ogc/rim/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://geolabs.github.io/bblocks-data-types/def/data-type/elevation-model/item> a dt:DataTypeItem,
        rim:RegisterItem ;
    dct:title "Elevation model"@en ;
    rim:inRegister dt:register ;
    rim:itemClass dt:dataTypeItemClass ;
    rim:objectIdentifier "https://geolabs.github.io/bblocks-data-types/def/data-type/elevation-model/item"^^xsd:anyURI ;
    rim:publicationStatus rim:published ;
    rim:realizes <https://geolabs.github.io/bblocks-data-types/def/data-type/elevation-model/v1> ;
    rim:validityStatus rim:invalid .

<https://geolabs.github.io/bblocks-data-types/def/data-type/elevation-model> a skos:Concept,
        dt:DataType,
        rim:Concept ;
    dct:source [ dct:references <https://docs.ogc.org/is/09-146r8/09-146r8.html> ;
            dct:title "OGC 09-146r8 Coverage Implementation Schema (CIS) 1.1.1, §6.5 RangeType"@en ],
        [ dct:references <https://saga-gis.sourceforge.io/saga_tool_doc/7.3.0/ta_morphometry.html> ;
            dct:title "SAGA 7.3.0 Terrain Analysis tools, Elevation grid inputs"@en ] ;
    skos:broader <https://geolabs.github.io/bblocks-data-types/def/data-type/raster-single-band> ;
    skos:definition "A single-band raster whose values are elevations of the terrain or of a surface (DEM, DTM, DSM)."@en ;
    skos:inScheme dt:dataTypes ;
    skos:prefLabel "Elevation model"@en .

<https://geolabs.github.io/bblocks-data-types/def/data-type/elevation-model/actions/addition> a rim:RegisterAction ;
    prov:startedAtTime "2026-10-08T00:00:00+00:00"^^xsd:dateTime ;
    rim:actionType rim:additionAction ;
    rim:proposer dt:geolabs .

<https://geolabs.github.io/bblocks-data-types/def/data-type/elevation-model/v1> a dt:DataTypeVersion,
        rim:ConceptVersion ;
    dt:hasVersionAction <https://geolabs.github.io/bblocks-data-types/def/data-type/elevation-model/actions/addition> ;
    rim:functionalIdentifier "https://geolabs.github.io/bblocks-data-types/def/data-type/elevation-model"^^xsd:anyURI ;
    rim:objectIdentifier "https://geolabs.github.io/bblocks-data-types/def/data-type/elevation-model/v1"^^xsd:anyURI ;
    rim:publicationStatus rim:published ;
    rim:validityStatus rim:invalid ;
    rim:version "1.0" ;
    rim:versionOf <https://geolabs.github.io/bblocks-data-types/def/data-type/elevation-model> .

