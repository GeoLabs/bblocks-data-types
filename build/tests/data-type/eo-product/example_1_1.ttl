@prefix dt: <https://w3id.org/geolabs/ospd/data-types/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rim: <https://w3id.org/ogc/rim/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://w3id.org/geolabs/ospd/data-types/data-type/eo-product/item> a dt:DataTypeItem ;
    rim:inRegister dt:register ;
    rim:itemClass dt:dataTypeItemClass ;
    rim:objectIdentifier "https://w3id.org/geolabs/ospd/data-types/data-type/eo-product/item"^^xsd:anyURI ;
    rim:publicationStatus rim:published ;
    rim:realizes <https://w3id.org/geolabs/ospd/data-types/data-type/eo-product/v1> ;
    rim:validityStatus rim:invalid .

<https://w3id.org/geolabs/ospd/data-types/data-type/eo-product> a rim:Concept ;
    skos:definition "A dataset delivered as one unit by a data provider, typically one acquisition over one area, made of several assets such as spectral bands, masks and metadata, and described by metadata." ;
    skos:inScheme dt:data-types ;
    skos:prefLabel "Earth observation product" .

<https://w3id.org/geolabs/ospd/data-types/data-type/eo-product/actions/addition> a rim:RegisterAction ;
    prov:startedAtTime "2026-11-10T00:00:00+00:00"^^xsd:dateTime ;
    rim:actionType rim:additionAction ;
    rim:proposer <https://w3id.org/geolabs/ospd/org/geolabs> .

<https://w3id.org/geolabs/ospd/data-types/data-type/eo-product/v1> a dt:DataTypeVersion ;
    dt:hasVersionAction <https://w3id.org/geolabs/ospd/data-types/data-type/eo-product/actions/addition> ;
    rim:functionalIdentifier "https://w3id.org/geolabs/ospd/data-types/data-type/eo-product"^^xsd:anyURI ;
    rim:objectIdentifier "https://w3id.org/geolabs/ospd/data-types/data-type/eo-product/v1"^^xsd:anyURI ;
    rim:publicationStatus rim:published ;
    rim:validityStatus rim:invalid ;
    rim:version "1.0" ;
    rim:versionOf <https://w3id.org/geolabs/ospd/data-types/data-type/eo-product> .

