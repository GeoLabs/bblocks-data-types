@prefix dct: <http://purl.org/dc/terms/> .
@prefix dt: <https://geolabs.github.io/bblocks-data-types/def/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rim: <https://w3id.org/ogc/rim/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://geolabs.github.io/bblocks-data-types/def/data-type/string-uuid/item> a dt:DataTypeItem ;
    dct:isReplacedBy <https://w3id.org/geolabs/ospd/data-formats/format/string-uuid> ;
    rim:inRegister dt:register ;
    rim:itemClass dt:dataTypeItemClass ;
    rim:objectIdentifier "https://geolabs.github.io/bblocks-data-types/def/data-type/string-uuid/item"^^xsd:anyURI ;
    rim:publicationStatus rim:unpublished ;
    rim:realizes <https://geolabs.github.io/bblocks-data-types/def/data-type/string-uuid/v1> ;
    rim:validityStatus rim:invalid .

<https://geolabs.github.io/bblocks-data-types/def/data-type/string-uuid> a rim:Concept ;
    skos:definition "A string representation of a universally unique identifier (UUID)." ;
    skos:inScheme dt:data-types ;
    skos:prefLabel "UUID string" .

<https://geolabs.github.io/bblocks-data-types/def/data-type/string-uuid/actions/addition> a rim:RegisterAction ;
    prov:startedAtTime "2026-11-01T00:00:00+00:00"^^xsd:dateTime ;
    rim:actionType rim:additionAction ;
    rim:proposer dt:geolabs .

<https://geolabs.github.io/bblocks-data-types/def/data-type/string-uuid/v1> a dt:DataTypeVersion ;
    dt:hasVersionAction <https://geolabs.github.io/bblocks-data-types/def/data-type/string-uuid/actions/addition> ;
    rim:functionalIdentifier "https://geolabs.github.io/bblocks-data-types/def/data-type/string-uuid"^^xsd:anyURI ;
    rim:objectIdentifier "https://geolabs.github.io/bblocks-data-types/def/data-type/string-uuid/v1"^^xsd:anyURI ;
    rim:publicationStatus rim:unpublished ;
    rim:validityStatus rim:invalid ;
    rim:version "1.0" ;
    rim:versionOf <https://geolabs.github.io/bblocks-data-types/def/data-type/string-uuid> .

