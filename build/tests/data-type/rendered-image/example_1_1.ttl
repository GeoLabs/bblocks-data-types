@prefix dt: <https://geolabs.github.io/bblocks-data-types/def/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rim: <https://w3id.org/ogc/rim/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://geolabs.github.io/bblocks-data-types/def/data-type/rendered-image/item> a dt:DataTypeItem ;
    rim:inRegister dt:register ;
    rim:itemClass dt:dataTypeItemClass ;
    rim:objectIdentifier "https://geolabs.github.io/bblocks-data-types/def/data-type/rendered-image/item"^^xsd:anyURI ;
    rim:publicationStatus rim:published ;
    rim:realizes <https://geolabs.github.io/bblocks-data-types/def/data-type/rendered-image/v1> ;
    rim:validityStatus rim:invalid .

<https://geolabs.github.io/bblocks-data-types/def/data-type/rendered-image> a rim:Concept ;
    skos:definition "A picture of data made for viewing: a grid of colour values produced by applying a colour map or a style to data, with or without georeferencing." ;
    skos:inScheme dt:data-types ;
    skos:prefLabel "Rendered image" .

<https://geolabs.github.io/bblocks-data-types/def/data-type/rendered-image/actions/addition> a rim:RegisterAction ;
    prov:startedAtTime "2026-11-10T00:00:00+00:00"^^xsd:dateTime ;
    rim:actionType rim:additionAction ;
    rim:proposer dt:geolabs .

<https://geolabs.github.io/bblocks-data-types/def/data-type/rendered-image/v1> a dt:DataTypeVersion ;
    dt:hasVersionAction <https://geolabs.github.io/bblocks-data-types/def/data-type/rendered-image/actions/addition> ;
    rim:functionalIdentifier "https://geolabs.github.io/bblocks-data-types/def/data-type/rendered-image"^^xsd:anyURI ;
    rim:objectIdentifier "https://geolabs.github.io/bblocks-data-types/def/data-type/rendered-image/v1"^^xsd:anyURI ;
    rim:publicationStatus rim:published ;
    rim:validityStatus rim:invalid ;
    rim:version "1.0" ;
    rim:versionOf <https://geolabs.github.io/bblocks-data-types/def/data-type/rendered-image> .

